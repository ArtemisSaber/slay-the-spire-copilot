LLM_PROVIDER=pollinations-free
LLM_BASE_URL=https://text.pollinations.ai/openai
LLM_API_KEY=
LLM_MODEL=openai-fast
LLM_MODEL_FAST=openai-fast
LLM_MODEL_MEDIUM=
LLM_MODEL_HEAVY=
LLM_MAX_TOKENS=50000
LLM_MAX_TOKENS_FAST=300
LLM_MAX_TOKENS_MEDIUM=
LLM_MAX_TOKENS_HEAVY=
LLM_TEMPERATURE=0.7
LLM_LOG_PROMPTS=
LLM_DISABLE_FAST_THINKING=
AUTO_PLAY=false
# AUTO_PLAY_AUTO_START=true   # Start in Auto mode without overlay mod

# External experience memory (disabled by default)
MEMORY_MODE=off
MEMORY_MAX_ITEMS=3
MEMORY_MAX_CONTEXT_BYTES=2048
MEMORY_CASE_MIN_SIMILARITY=800
MEMORY_LESSON_MIN_SIMILARITY=700
MEMORY_PROPOSED_LESSON_MIN_SIMILARITY=850
MEMORY_MAX_CASES_PER_RUN=500
